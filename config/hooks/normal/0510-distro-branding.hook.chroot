#!/bin/sh

set -e

echo "=== Applying Distro Branding (Dizdar Linux Everywhere) ==="

# 1. Update OS Release Information (System properties, About OS, neofetch)
cat << 'EOF' > /etc/os-release
PRETTY_NAME="Dizdar Linux"
NAME="Dizdar Linux"
VERSION_ID="1.0"
VERSION="1.0"
ID=dizdar
ID_LIKE=debian
HOME_URL="https://github.com/edizdar/dizdar-linux-builder"
SUPPORT_URL="https://github.com/edizdar/dizdar-linux-builder/issues"
BUG_REPORT_URL="https://github.com/edizdar/dizdar-linux-builder/issues"
EOF

cp /etc/os-release /usr/lib/os-release || true

# 2. Update Console Login Banners (TTY / issue)
echo "Dizdar Linux \n \l" > /etc/issue
echo "Dizdar Linux" > /etc/issue.net
echo "Dizdar Linux" > /etc/motd

# 3. Custom Branding for Calamares Graphical Installer
if [ -d /etc/calamares/branding/debian ]; then
    echo "Ensuring Calamares installer logos and branding..."
    if [ -f /usr/share/pixmaps/dizdar-logo.png ]; then
        cp -f /usr/share/pixmaps/dizdar-logo.png /etc/calamares/branding/debian/debian-logo.png 2>/dev/null || true
        cp -f /usr/share/pixmaps/dizdar-logo.png /etc/calamares/branding/debian/dizdar-logo.png 2>/dev/null || true
    fi
fi

# 4. Clean up default Debian menu shortcuts/branding
if [ -f /usr/share/desktop-directories/debian-menu.directory ]; then
    rm -f /usr/share/desktop-directories/debian-menu.directory
fi
rm -f /etc/skel/Desktop/install-debian.desktop || true
rm -f /usr/share/applications/install-debian.desktop || true

# 5. Plymouth Boot Animation Branding
echo "Purging all Debian artwork from desktop-base and plymouth..."
WATERMARK="/usr/share/plymouth/themes/spinner/watermark.png"
LOGO="/usr/share/pixmaps/dizdar-logo.png"

if [ -f "$WATERMARK" ]; then
    find /usr/share/desktop-base /usr/share/plymouth -type f \( -name "*watermark*.png" -o -name "*watermark*.svg" \) -exec cp -f "$WATERMARK" {} \; 2>/dev/null || true
fi

if [ -f "$LOGO" ]; then
    find /usr/share/desktop-base /usr/share/plymouth -type f \( -name "*logo*.png" -o -name "*logo*.svg" -o -name "*debian*.png" -o -name "*debian*.svg" \) -exec cp -f "$LOGO" {} \; 2>/dev/null || true
fi

# Force initramfs regeneration for ALL kernels in chroot (/boot)
if command -v update-initramfs >/dev/null 2>&1; then
    echo "Updating initramfs for all kernels (-k all) with Dizdar Linux Plymouth splash..."
    update-initramfs -u -k all || true
fi

# 6. Ensure desktop, installer, and application permissions
chmod 0440 /etc/sudoers.d/* 2>/dev/null || true
chmod 644 /etc/polkit-1/rules.d/* /etc/polkit-1/localauthority/50-local.d/* 2>/dev/null || true
chmod 755 /etc/skel/Desktop/*.desktop /usr/share/applications/dizdar-*.desktop /usr/local/bin/* 2>/dev/null || true

echo "=== Distro Branding Applied Successfully ==="
