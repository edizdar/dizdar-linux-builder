#!/bin/bash
# Dizdar Linux Calamares Launcher - Tam Korumali ve Guvenli

LOGFILE="/tmp/calamares-dizdar.log"
exec > >(tee -a "$LOGFILE") 2>&1

echo "========================================================"
echo "  Dizdar Linux Kurulum Yoneticisi Baslatiliyor"
echo "  Tarih: $(date)"
echo "  Kullanici: $(whoami) (UID: $(id -u))"
echo "  DISPLAY: $DISPLAY"
echo "========================================================"

# 1. Stale fstab temizligi (Debian live-build kaynakli bolumleme sorununu onler)
if [ -f /etc/fstab ]; then
    echo "Gecici live fstab dosyasi calamares icin yedekleniyor..."
    sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null || true
fi

# Cikis aninda fstab dosyasini geri yukle
cleanup() {
    if [ -f /etc/fstab.orig.calamares ]; then
        sudo mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# 2. X11 Erisim Yetkilerini Guvenceye Al
export DISPLAY="${DISPLAY:-:0}"
xhost +local:root >/dev/null 2>&1 || true
xhost +si:localuser:root >/dev/null 2>&1 || true
xhost + >/dev/null 2>&1 || true

# 3. Qt ve Ekran Ayarlari
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_QPA_PLATFORM=xcb

# 4. Onceki kalan calamares sureclerini temizle
killall -9 calamares 2>/dev/null || true

# 5. Calamares calistirilabilir dosyasini bul
CALAMARES_BIN=""
if [ -x /usr/bin/calamares ]; then
    CALAMARES_BIN="/usr/bin/calamares"
elif [ -x /usr/local/bin/calamares ]; then
    CALAMARES_BIN="/usr/local/bin/calamares"
elif command -v calamares >/dev/null 2>&1; then
    CALAMARES_BIN=$(command -v calamares)
fi

if [ -z "$CALAMARES_BIN" ]; then
    echo "HATA: Calamares yukleyicisi bulunamadi!"
    zenity --error --title="Dizdar Linux Kurulum" --text="Calamares yukleyici programi sistemde bulunamadi!" --width=400 2>/dev/null || true
    exit 1
fi

echo "Calamares baslatiliyor: $CALAMARES_BIN"

# 6. Calamares'i superuser haklariyla baslat
if [ "$(id -u)" -eq 0 ]; then
    $CALAMARES_BIN -d "$@"
    RET=$?
else
    # Sudo ile baslat (NOPASSWD)
    sudo -E DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=1 $CALAMARES_BIN -d "$@"
    RET=$?
    
    # Eger sudo basarisiz olduysa pkexec ile yedek dene
    if [ $RET -ne 0 ] && command -v pkexec >/dev/null 2>&1; then
        echo "Sudo basarisiz oldu (kod: $RET), pkexec deneniyor..."
        pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=1 $CALAMARES_BIN -d "$@"
        RET=$?
    fi
fi

echo "Calamares sonlandi, cikis kodu: $RET"

# Eger kullanici kurulumu basariyla tamamladiysa veya kendisi kapattiysa sessizce cik
if [ $RET -ne 0 ]; then
    SESSION_LOG="/root/.cache/calamares/session.log"
    if [ ! -f "$SESSION_LOG" ]; then
        SESSION_LOG="$HOME/.cache/calamares/session.log"
    fi
    
    if grep -q "Installation cancelled" "$SESSION_LOG" 2>/dev/null; then
        echo "Kullanici kurulumu iptal etti."
        exit 0
    fi
fi

exit $RET
