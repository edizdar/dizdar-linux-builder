#!/bin/bash
# Dizdar Linux Kurulum Sihirbazi Baslatici

# X11 erisim yetkisini root kullanicisina ver
xhost +local:root >/dev/null 2>&1 || true

# Eger zaten root ise dogrudan calistir
if [ "$(id -u)" -eq 0 ]; then
    exec /usr/bin/calamares "$@"
fi

# sudo ile calistir
if command -v sudo >/dev/null 2>&1; then
    exec sudo -E /usr/bin/calamares "$@"
fi

# pkexec alternatifi
if command -v pkexec >/dev/null 2>&1; then
    exec pkexec /usr/bin/calamares "$@"
fi

# fallback
exec /usr/bin/calamares "$@"
